# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Full read-write URL, used only by migrations and the seed script.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Read-only URL used by the application at runtime. This is a SEPARATE
# Postgres role that has SELECT and nothing else. See docs/04-security.md
DATABASE_URL_READONLY=postgresql://t2s_readonly:password@host/dbname?sslmode=require

# --- LLM providers (all have free tiers; you need at least one) -----------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Provider preference order, comma separated. First available wins.
LLM_PROVIDER_ORDER=groq,gemini,openai

# --- Application ----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Hard limits enforced before any query reaches the database
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_SECONDS=10
MAX_CLARIFICATION_ROUNDS=2
